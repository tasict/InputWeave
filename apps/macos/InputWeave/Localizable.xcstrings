{
  "sourceLanguage": "en",
  "strings": {
    "%@ and %lld more items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 與另外 %2$lld 個項目"
          }
        }
      }
    },
    "%@ and 1 more item": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 與另外 1 個項目"
          }
        }
      }
    },
    "%@ can't be reached.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到「%@」。"
          }
        }
      }
    },
    "%@ cannot be reached. Check that both computers are on the same network.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到「%@」。請確認兩台電腦在同一個網路上。"
          }
        }
      }
    },
    "%@ could not take the file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法接收這個檔案。"
          }
        }
      }
    },
    "%@ declined the file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」拒絕了這個檔案。"
          }
        }
      }
    },
    "%@ declined the pairing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」拒絕了配對。"
          }
        }
      }
    },
    "%@ didn’t wake up. Wake for network access may be off on it, or it may not be on a wired network.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」沒有醒來。它可能沒有打開網路喚醒，或沒有接在有線網路上。"
          }
        }
      }
    },
    "%@ does not accept new devices.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」目前不接受新裝置配對。"
          }
        }
      }
    },
    "%@ does not receive files.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不接收檔案。"
          }
        }
      }
    },
    "%@ hasn’t told this computer how to wake it yet. You can wake it after it connects again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」還沒告訴這台怎麼喚醒它；下次連上之後就能喚醒。"
          }
        }
      }
    },
    "%@ is awake.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」醒來了。"
          }
        }
      }
    },
    "%@ is back online.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已恢復連線。"
          }
        }
      }
    },
    "%@ is offline for now.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」暫時離線。"
          }
        }
      }
    },
    "%@ is pairing with another computer. Try again in a moment.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在和其他電腦配對，請稍後再試。"
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩下 %@"
          }
        }
      }
    },
    "%@ needs %@ more free space.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」還需要 %2$@ 的可用空間。"
          }
        }
      }
    },
    "%@ runs a version of InputWeave that cannot pair with this one. Update both.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的 InputWeave 版本無法和這台配對，請將兩台都更新。"
          }
        }
      }
    },
    "%@ runs an older InputWeave that doesn’t know about this and still controls it. Update %@ to 1.1.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」的 InputWeave 是舊版，不認得暫時離線，仍會控制它。請把「%2$@」更新到 1.1。"
          }
        }
      }
    },
    "%@ took this computer offline for now.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」把這台設為暫時離線。"
          }
        }
      }
    },
    "%@ uses the same device ID as a computer you already have.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的裝置 ID 和已有的電腦相同。"
          }
        }
      }
    },
    "%@ wants to send you %u items (%@, %@).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」想傳送 %2$u 個項目給你（%3$@，%4$@）。"
          }
        }
      }
    },
    "%@ wants to send you a file": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」想傳送檔案給你"
          }
        }
      }
    },
    "%@ wants to send you files": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」想傳送檔案給你"
          }
        }
      }
    },
    "%@ wants to send you this file (%@).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」想傳送這個檔案給你（%2$@）。"
          }
        }
      }
    },
    "%@ wants to send you this folder (%@, %@).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」想傳送這個資料夾給你（%2$@，%3$@）。"
          }
        }
      }
    },
    "%@ · %@/s · %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@・%2$@/s・%3$@"
          }
        }
      }
    },
    "%@, %lld screens, next to %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$lld 個螢幕，緊鄰 %3$@"
          }
        }
      }
    },
    "%@, %lld screens, not next to another computer": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$lld 個螢幕，沒有和其他電腦相接"
          }
        }
      }
    },
    "%lld days ago": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day ago"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days ago"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天前"
          }
        }
      }
    },
    "%lld hours ago": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld hour ago"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld hours ago"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小時前"
          }
        }
      }
    },
    "%lld minutes ago": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minute ago"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes ago"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分鐘前"
          }
        }
      }
    },
    "%lld more…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %lld 個…"
          }
        }
      }
    },
    "%u files": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%u 個檔案"
          }
        }
      }
    },
    "%u items (%@, %@)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$u 個項目（%2$@，%3$@）"
          }
        }
      }
    },
    "%u of %@ · %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@中的 %1$u 個・%3$@"
          }
        }
      }
    },
    "%u received, %u failed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$u 個已收到，%2$u 個失敗"
          }
        }
      }
    },
    "%u sent, %u failed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$u 個已傳送，%2$u 個失敗"
          }
        }
      }
    },
    ", %lld files could not be sent": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，有 %lld 個檔案無法傳送"
          }
        }
      }
    },
    ", 1 file could not be sent": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，有 1 個檔案無法傳送"
          }
        }
      }
    },
    "1 file": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 個檔案"
          }
        }
      }
    },
    "A name is 1 to 64 characters.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱長度為 1 到 64 個字元。"
          }
        }
      }
    },
    "A password field is active, so keystrokes can't reach other computers right now.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼欄位使用中，按鍵暫時無法傳到其他電腦。"
          }
        }
      }
    },
    "A short glow in the seam color shows where the cursor left this computer's screen, or came in.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標離開或進入這台螢幕的地方，邊緣會短暫亮起縫線色的光。"
          }
        }
      }
    },
    "A text file to attach when reporting a problem: versions, settings, connection state and recent logs. It contains no keys, file names or clipboard contents.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回報問題時可以附上的文字檔，內容包括版本、設定、連線狀態與最近的記錄；不含金鑰、檔名或剪貼簿內容。"
          }
        }
      }
    },
    "About InputWeave": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於 InputWeave"
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "Acknowledgments": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "致謝"
          }
        }
      }
    },
    "Acknowledgments…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "致謝…"
          }
        }
      }
    },
    "Add Device": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增裝置"
          }
        }
      }
    },
    "Add Device…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增裝置…"
          }
        }
      }
    },
    "Add by IP Address": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 IP 位址新增"
          }
        }
      }
    },
    "After quitting, this computer stops sharing its keyboard, mouse, clipboard and files with your other computers until you log in again or reopen InputWeave. If you only hide the menu bar icon, open InputWeave from the Applications folder to show it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束後，這台電腦不會再和其他電腦共享鍵鼠、剪貼簿和檔案，直到下次登入或重新開啟 InputWeave。如果只隱藏選單列圖示，之後從「應用程式」再開啟一次 InputWeave，圖示就會重新出現。"
          }
        }
      }
    },
    "Allow Access": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許存取"
          }
        }
      }
    },
    "Allow in the Background": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許在背景執行"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許"
          }
        }
      }
    },
    "Also delete pairings; other computers will have to pair with this Mac again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一併刪除配對資料；其他電腦需要重新和這台 Mac 配對"
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總是"
          }
        }
      }
    },
    "And %lld more": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %lld 個"
          }
        }
      }
    },
    "Another computer took this computer offline for now.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台電腦把這台設為暫時離線。"
          }
        }
      }
    },
    "Another pairing is in progress.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個配對正在進行中。"
          }
        }
      }
    },
    "Applies from the next time the login window shows, such as after you log out, as long as you were the last to log in. With FileVault on, a Mac that restarts asks for its password before macOS starts, so it doesn't apply then.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從下一次出現登入視窗起生效，例如登出之後，前提是最後登入的是你。開啟 FileVault 時，Mac 重新開機後會在 macOS 啟動前先要求密碼，那時無法使用。"
          }
        }
      }
    },
    "Arrangement": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排列"
          }
        }
      }
    },
    "Ask each time": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次詢問"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        }
      }
    },
    "Back on this computer.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已切回這台。"
          }
        }
