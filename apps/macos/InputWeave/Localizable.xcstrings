    },
    "Background service": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景服務"
          }
        }
      }
    },
    "Bring Back Online": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復連線"
          }
        }
      }
