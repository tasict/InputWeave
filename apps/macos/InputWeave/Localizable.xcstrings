            "value": "離線"
          }
        }
      }
    },
    "One keyboard and mouse for every computer on your desk.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一組鍵盤滑鼠，控制桌上的每一台電腦。"
          }
        }
      }
    },
    "Only F13–F19 work alone. Other keys need a modifier: ⌃, ⌥, ⇧ or ⌘.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單一按鍵只能用 F13–F19；其他按鍵要加上修飾鍵：⌃、⌥、⇧ 或 ⌘。"
          }
        }
      }
    },
    "Only this Mac stops; the other computer is not told.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有這台 Mac 停止，不會通知對方。"
          }
        }
      }
    },
    "Open InputWeave at login": {
      "localizations": {
