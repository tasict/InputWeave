        }
      }
    },
    "Computers are numbered from left to right in the arrangement, and each number is shown next to the computer's name. While recording, press Esc to cancel or Delete to go back to the default.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦依排列由左到右編號，編號顯示在電腦名稱旁邊。錄製時按 Esc 取消，按 Delete 回到預設值。"
          }
        }
      }
    },
